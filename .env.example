# Set to openai or gemini. If blank, uses Gemini when only its key is set.
MODEL_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# OpenAI research: sol plans, terra drives, sol reviews.
RESEARCH_PLAN_MODEL=gpt-5.6-sol
RESEARCH_GATHER_MODEL=gpt-5.6-terra
RESEARCH_REASON_MODEL=gpt-5.6-sol
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=3000

# Optional private player-assessment service (host only; never exposed to sandbox/browser)
RISKOS_URL=http://127.0.0.1:8091
RISKOS_TOKEN=
