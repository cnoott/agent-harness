# Set to openai or gemini. If blank, uses Gemini when only its key is set.
MODEL_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Context budget including 8192 tokens reserved for instructions, tools, and output.
HARNESS_CONTEXT_TOKENS=32000
PORT=3000
